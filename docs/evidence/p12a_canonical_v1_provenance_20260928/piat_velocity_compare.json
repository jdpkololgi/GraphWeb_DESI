      "blob_url": "https://github.com/JadePiat/hodpy/blob/5894fbbafa7f4b2e4d69ad37852d38d528cb2aef/hodpy%2Fgalaxy_catalogue_snapshot.py",
      "raw_url": "https://github.com/JadePiat/hodpy/raw/5894fbbafa7f4b2e4d69ad37852d38d528cb2aef/hodpy%2Fgalaxy_catalogue_snapshot.py",
      "contents_url": "https://api.github.com/repos/JadePiat/hodpy/contents/hodpy%2Fgalaxy_catalogue_snapshot.py?ref=5894fbbafa7f4b2e4d69ad37852d38d528cb2aef",
      "patch": "@@ -51,15 +51,19 @@ def _get_velocities(self):\n         # velocity of halo\n         vel_halo = self.get_halo(\"vel\")\n \n+        # satellite galaxies\n+        is_sat = self.get(\"is_sat\")\n+        Nsat = np.count_nonzero(is_sat)\n+\n         # velocity dispersion from Eq. 12 of Skibba+2006 (in proper km/s)\n         vel_disp = np.sqrt(2.151e-9 * (self.get_halo(\"mass\")*\\\n                           (1.+self.get_halo(\"zcos\"))/self.get_halo(\"r200\")))\n \n         # random velocity along each axis\n         vel_rel = np.zeros(vel_halo.shape)\n         for i in range(3):\n-            vel_rel[:,i] = vel_disp*np.random.normal(loc=0.0, scale=1.0, \n-                                                     size=self.size)\n+            vel_rel[is_sat,i] = vel_disp[is_sat]*np.random.normal(loc=0.0, scale=1.0, \n+                                                     size=Nsat)\n \n         return vel_halo + vel_rel\n "
    }
  ]
