# ──────────────────────────────────────────────────────────────────────
# GraphWeb_DESI repo .gitignore
# Rule of thumb: TRACK source, configs, docs, small fixtures.
#                IGNORE generated artifacts, large data, logs, secrets, cruft.
# Force-track an exception with:  git add -f <path>
# ──────────────────────────────────────────────────────────────────────

# OS / editor cruft
.DS_Store
._*
.ipynb_checkpoints/
.vscode/

# Python
__pycache__/
*.pyc
*.pyo

# Secrets / local environment (never commit)
.env
*.key
*.pem

# DESI catalogs & large data
*.fits
*.npy
*.npz
*.csv

# Graph caches, model weights, pickled artifacts
cache/
*.pkl
*.pt
*.pth

# Figures / rendered outputs
*.pdf
*.png
*.gif
*.html

# Local scratch / experiments — keep throwaway run scripts here, off the remote
scratch/
sandbox/

# Retired areas — hidden from git; delete the files on disk whenever you're ready
archive/
legacy/
to-delete/

# Exploratory notebooks intentionally kept out of the repo
1_loaSampleSelection_forDK.ipynb
2_loaSelectedSample_massCompletenessCut_forDK.ipynb
5_loa+LSSsample_massCompletenessCut.ipynb
